  //     "args": ["/K", "C:\\Development\\cmder\\vendor\\bin\\vscode_init.cmd"]
  //   }
  // },
  // "terminal.integrated.defaultProfile.windows": "Cmder",

  /**********************************************************************************************************************
                                                            END
********************************************************************************************************************/
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  /**********************************************************************************************************************
      ESLINT Rules
********************************************************************************************************************/
  "eslint.enable": true,

  "editor.codeActionsOnSave": {
    "source.fixAll": true,
    "source.organizeImports": false,
    "source.sortMembers": false
  },

  // "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.proseWrap": "preserve",

  "editor.formatOnPaste": false, // required
  "editor.formatOnType": false, // required
  "editor.formatOnSave": true, // optional
  "editor.formatOnSaveMode": "file", // required to format on save
  "files.autoSave": "onFocusChange", // optional but recommended

  "prettier.enableDebugLogs": true,
  "prettier.endOfLine": "auto",
  "prettier.printWidth": 120,
  "prettier.singleAttributePerLine": true,
  /**********************************************************************************************************************
                                                            END
********************************************************************************************************************/
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  /**********************************************************************************************************************
      GENERIC configs
********************************************************************************************************************/

  "security.workspace.trust.untrustedFiles": "open",

  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },

  "editor.suggestSelection": "first",

  "cSpell.ignorePaths": ["./yarn.lock", "./package-lock.json"],
  "cSpell.userWords": ["browserslist", "Chabot", "Icaro", "Kubernetes", "Matheus", "neofinancial"],
  "cSpell.ignoreWords": ["typedefs"],

  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  // GIT CONFIGS
  "diffEditor.ignoreTrimWhitespace": false,
  "git.confirmSync": false,
  "git.enableCommitSigning": true,
  "githubPullRequests.pullBranch": "never",
  "git.pullBeforeCheckout": true,
  "git.openRepositoryInParentFolders": "never",

  "json.format.enable": true,

  "jest.autoRun": "off",
  "jest.autoRevealOutput": "on-run",
  "jestrunner.jestCommand": "npm test",
  "jestrunner.changeDirectoryToWorkspaceRoot": true,

  "workbench.layoutControl.enabled": false,

  "editor.linkedEditing": true,

  "mdtableeditor.commandViews": {
    "toolbar": [
      "MdTableEditor.changeAlignCenter",
      "MdTableEditor.changeAlignLeft",
      "MdTableEditor.changeAlignRight",
      "MdTableEditor.columnSelectEmpty",
      "MdTableEditor.fillCells",
      "MdTableEditor.insertBottom",
      "MdTableEditor.insertLeft",
      "MdTableEditor.insertRight",
      "MdTableEditor.insertTop",
      "MdTableEditor.moveBottom",
      "MdTableEditor.moveLeft",
      "MdTableEditor.moveRight",
      "MdTableEditor.moveTop",
      "MdTableEditor.removeColumn",
      "MdTableEditor.removeRow",
      "MdTableEditor.sortNumberAsc",
      "MdTableEditor.sortNumberDesc",
      "MdTableEditor.sortTextAsc.ignore",
      "MdTableEditor.sortTextDesc.ignore"
    ],
    "context": [
      "MdTableEditor.fillCells",
      "MdTableEditor.insertTop",
      "MdTableEditor.insertBottom",
      "MdTableEditor.insertLeft",
      "MdTableEditor.insertRight",
      "MdTableEditor.removeColumn",
      "MdTableEditor.removeRow",
      "MdTableEditor.columnSelectEmpty",
      "MdTableEditor.sortNumberAsc",
      "MdTableEditor.sortNumberDesc",
      "MdTableEditor.sortTextAsc.ignore",
      "MdTableEditor.sortTextDesc.ignore"
    ]
  },

  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },

  "npm.keybindingsChangedWarningShown": true,
  "redhat.telemetry.enabled": true,
  /**********************************************************************************************************************
                                                            END
********************************************************************************************************************/
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  //|
  /**********************************************************************************************************************
      EDITOR STYLES
********************************************************************************************************************/
  "editor.fontFamily": "Consolas, 'Courier New', monospace",

  "editor.renderWhitespace": "selection", // remove the spaces visual dots

  "editor.wordWrap": "on",

  "window.menuBarVisibility": "classic",

  // FONT SIZE
  "editor.fontSize": 16,
  "workbench.tree.indent": 20,
  "editor.lineHeight": 20,

  "editor.fontLigatures": true,
  "editor.renderLineHighlight": "all", // Enable the highlight color on the selected line
  "breadcrumbs.enabled": true, // Enable the file path in top of the window

  // STYLE
  "workbench.colorTheme": "Monokai Dimmed",
  "workbench.colorCustomizations": {
    "[Monokai Dimmed]": {
      "editor.background": "#000000",
      "titleBar.activeBackground": "#505050",
      "sideBarSectionHeader.background": "#666666",
      "sideBar.background": "#424242",
      "menu.foreground": "#fdfdfd",
      "menu.background": "#0e0d0d",
      "activityBar.background": "#000000",
      "editorError.border": "#ff0101",
      "statusBar.background": "#007acc",
      "contrastActiveBorder": "#ff7301",
      "editorLineNumber.foreground": "#fbfbfb",
      "editor.selectionBackground": "#82ff2f",
      "editor.lineHighlightBackground": "#fc04045b",
      "editor.selectionHighlightBackground": "#42f7eeab",
      "editorLineNumber.activeForeground": "#f31919",
      "editorIndentGuide.activeBackground": "#f31919",
      "terminal.ansiBlack": "#34424e",
      "terminal.ansiBlue": "#15b8ae",
      "terminal.ansiBrightBlack": "#53687c",
      "terminal.ansiBrightBlue": "#49eae0",
      "terminal.ansiBrightCyan": "#07fdc0",
      "terminal.ansiBrightGreen": "#07c9fd",
      "terminal.ansiBrightMagenta": "#07c9fd",
      "terminal.ansiBrightRed": "#f03e5f",
      "terminal.ansiBrightWhite": "#ff2424",
      "terminal.ansiBrightYellow": "#fd9207",
      "terminal.ansiCyan": "#019d76",
      "terminal.ansiGreen": "#017c9d",
      "terminal.ansiMagenta": "#adc4ca",
      "terminal.ansiRed": "#e60730",
      "terminal.ansiWhite": "#ff2424",
      "terminal.ansiYellow": "#08ff52"
    },
    "scrollbarSlider.background": "#f0703e",
    "scrollbarSlider.hoverBackground": "#f17006",
    "scrollbarSlider.activeBackground": "#f15c06"
  },

  // TOKENS DE CLASSES, FUNCTIONS, RETURN, ASYNC, STRING, HTML, ETC....
  "editor.tokenColorCustomizations": {
    "[Monokai Dimmed]": {
      "textMateRules": [
        {
          "scope": "entity.name.class, entity.name.type, keyword, support",
          "settings": {
            "fontStyle": "bold"
          }
        },
        {
          "scope": "entity.name.function, string",
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": "constant.numeric",
          "settings": { "foreground": "#e7de57", "fontStyle": "" }
        },
        {
          "scope": "variable.parameter, keyword.control, storage, token.error-token",
          "settings": {
            "fontStyle": "italic bold"
          }
        },
        {
          "scope": "entity.name.class, entity.name.type",
          "settings": {
            "foreground": "#C7444A"
          }
        },
        {
          "scope": "entity.name.type.ts",
          "settings": {
            "fontStyle": "italic bold",
            "foreground": "#c7444bc4"
          }
        },
        {
          "scope": "entity.name.function",
          "settings": {
            "foreground": "#ff9203"
          }
        },
        {
          "scope": "meta.tag",
          "settings": {
            "foreground": "#dedfde"
          }
        },
        {
          "scope": "variable.parameter",
          "settings": {
            "foreground": "#60a9f8"
          }
        },
        {
          "scope": "keyword, constant.language",
          "settings": {
            "foreground": "#9872a2ff"
          }
        },
        {
          "scope": "variable.other.property",
          "settings": {
            "foreground": "#6089B4"
          }
        },
        {
          "scope": "entity.name.tag",
          "settings": {
            "foreground": "#a0171e"
          }
        }
      ]
    }
  },

  // Styles for comments like TODO in the code
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "background": "#b8f807",
      "foreground": "#000000",
      "fontWeight": "bold",
      "type": "whole-line"
    }
  },

  "todo-tree.highlights.backgroundColourScheme": ["red", "orange", "yellow", "green", "blue", "indigo", "violet"],

  "workbench.iconTheme": "material-icon-theme"

  /**********************************************************************************************************************
                                                          END
********************************************************************************************************************/
}
