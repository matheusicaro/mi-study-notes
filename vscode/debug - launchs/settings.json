{
  "javascript.updateImportsOnFileMove.enabled": "always",
  "files.autoSave": "off",
  "editor.renderWhitespace": "all",
  "editor.wordWrap": "on",
  /*
    **********************************************************************************************************************
    TERMINAL INTEGRADO NO VSCODE
    *********************************************************************************************************************/
  "terminal.integrated.profiles.windows": {
    "Cmder": {
      "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
      "env": { "CMDER_ROOT": "C:\\Development\\Terminal" },
      "args": ["/K", "C:\\Development\\Terminal\\vendor\\bin\\vscode_init.cmd"]
    }
  },

  "terminal.integrated.defaultProfile.windows": "Cmder",

  // FONT SIZE
  "editor.fontSize": 16,
  "terminal.integrated.fontSize": 11,

  "workbench.tree.indent": 20,
  "editor.lineHeight": 20,
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.renderLineHighlight": "all", // Determina o de aplicar sombra na linha selecionada
  "breadcrumbs.enabled": true,
  "workbench.colorTheme": "Monokai Dimmed",

  "editor.rulers": [140], // Aplica linhas verdicais que referencia quebra de Linha
  "prettier.printWidth": 140,
  "editor.minimap.maxColumn": 140,
  /*
    **********************************************************************************************************************
        PERSONALIZAÇÃO [ STANDARD AND ESLINT - PRETTIER]
    *********************************************************************************************************************/
  "eslint.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.fixAll": true
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "prettier.proseWrap": "preserve",
  /* 
    *
    ######################################################################################################################
    PERSONALIZAÇÃO DE CORES
    ######################################################################################################################
    */
  "workbench.colorCustomizations": {
    //barra de rolagem
    "scrollbarSlider.background": "#f0703e",
    "scrollbarSlider.hoverBackground": "#f17006",
    "scrollbarSlider.activeBackground": "#f15c06",
    // THEME BLACK **************************************
    "[Monokai Dimmed]": {
      "editor.background": "#000000",
      "titleBar.activeBackground": "#505050",
      "sideBarSectionHeader.background": "#666666",
      "sideBar.background": "#424242",
      "menu.foreground": "#fdfdfd",
      "menu.background": "#0e0d0d",
      "list.hoverBackground": "#ff7575",
      "activityBar.background": "#000000",
      "editorError.border": "#ff0101",
      "statusBar.background": "#007acc",
      // borda de seleção
      "contrastActiveBorder": "#ff7301",
      // Numero de linhas
      "editorLineNumber.foreground": "#fbfbfb",
      // Seleção de texto no editor
      "editor.selectionBackground": "#c5cf316e",
      "editor.lineHighlightBackground": "#fc04045b",
      "editor.selectionHighlightBackground": "#02f7ff56",
      // ao posicionar o cursor -> numbero de linhas e linha de chaves
      "editorLineNumber.activeForeground": "#f31919",
      "editorIndentGuide.activeBackground": "#f31919",
      // TERMINAL EDIT
      "terminal.ansiBlack": "#34424e",
      "terminal.ansiBlue": "#15b8ae",
      "terminal.ansiBrightBlack": "#53687c",
      "terminal.ansiBrightBlue": "#49eae0",
      "terminal.ansiBrightCyan": "#07fdc0",
      "terminal.ansiBrightGreen": "#07c9fd",
      "terminal.ansiBrightMagenta": "#07c9fd",
      "terminal.ansiBrightRed": "#f03e5f",
      "terminal.ansiBrightWhite": "#ff2424",
      "terminal.ansiBrightYellow": "#fd9207",
      "terminal.ansiCyan": "#019d76",
      "terminal.ansiGreen": "#017c9d",
      "terminal.ansiMagenta": "#adc4ca",
      "terminal.ansiRed": "#e60730",
      "terminal.ansiWhite": "#ff2424",
      "terminal.ansiYellow": "#08ff52"
    },
    // THEME LIGHT **************************************
    "[Quiet Light]": {
      "titleBar.activeBackground": "#ffffff",
      "statusBar.background": "#007acc",
      "activityBar.foreground": "#000000",
      "activityBar.background": "#0579fd46",
      "sideBarSectionHeader.background": "#007acc46",
      "sideBar.background": "#ffffff",
      "list.activeSelectionBackground": "#0579fd46",
      "list.activeSelectionForeground": "#000000",
      "list.focusBackground": "#0579fd46",
      "list.focusForeground": "#000000",
      "editorWhitespace.foreground": "#eceaeac4",
      "editorLineNumber.foreground": "#000000",
      "editorLineNumber.activeForeground": "#d4d1d1",
      "editor.selectionBackground": "#bbb9b985",
      "editor.lineHighlightBackground": "#0579fd46",
      "editor.selectionHighlightBackground": "#fd050546",
      "contrastActiveBorder": "#1201ff",
      "list.inactiveSelectionBackground": "#0579fd46",
      "activityBarBadge.background": "#007acc",
      "editor.background": "#ffffff",
      "editor.foreground": "#000000",
      "editor.inactiveSelectionBackground": "#e5ebf1",
      "editorIndentGuide.activeBackground": "#939393",
      "editorIndentGuide.background": "#d3d3d3",
      "editorSuggestWidget.background": "#f3f3f3",
      "input.placeholderForeground": "#767676",
      "list.hoverBackground": "#e8e8e8",
      "scrollbarSlider.activeBackground": "#f15c06",
      "scrollbarSlider.background": "#f0703e",
      "scrollbarSlider.hoverBackground": "#f17006",
      "settings.numberInputBorder": "#cecece",
      "settings.textInputBorder": "#cecece",
      "sideBarTitle.foreground": "#6f6f6f",
      "terminal.background": "#fdfeff",
      "terminal.ansiBlack": "#34424e",
      "terminal.ansiBlue": "#15b8ae",
      "terminal.ansiBrightBlack": "#53687c",
      "terminal.ansiBrightBlue": "#49eae0",
      "terminal.ansiBrightCyan": "#07fdc0",
      "terminal.ansiBrightGreen": "#07c9fd",
      "terminal.ansiBrightMagenta": "#07c9fd",
      "terminal.ansiBrightRed": "#f03e5f",
      "terminal.ansiBrightWhite": "#ff2424",
      "terminal.ansiBrightYellow": "#fd9207",
      "terminal.ansiCyan": "#019d76",
      "terminal.ansiGreen": "#017c9d",
      "terminal.ansiMagenta": "#adc4ca",
      "terminal.ansiRed": "#e60730",
      "terminal.ansiWhite": "#ff2424",
      "terminal.ansiYellow": "#08ff52"
    }
  },
  // TOKENS DE CLASSES, FUNCTIONS, RETURN, ASYNC, STRING, HTML, ETC....
  "editor.tokenColorCustomizations": {
    "[Monokai Dimmed]": {
      "textMateRules": [
        {
          "scope": "entity.name.class, entity.name.type, keyword, support",
          "settings": {
            "fontStyle": "bold"
          }
        },
        {
          "scope": "entity.name.function, string",
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": "constant.numeric",
          "settings": { "foreground": "#e7de57", "fontStyle": "" }
        },
        {
          "scope": "variable.parameter, keyword.control, storage, token.error-token",
          "settings": {
            "fontStyle": "italic bold"
          }
        },
        {
          "scope": "entity.name.class, entity.name.type",
          "settings": {
            "foreground": "#C7444A"
          }
        },
        {
          "scope": "entity.name.type.ts",
          "settings": {
            "fontStyle": "italic bold",
            "foreground": "#c7444bc4"
          }
        },
        {
          "scope": "entity.name.function",
          "settings": {
            "foreground": "#ff9203"
          }
        },
        {
          "scope": "meta.tag",
          "settings": {
            "foreground": "#dedfde"
          }
        },
        {
          "scope": "variable.parameter",
          "settings": {
            "foreground": "#60a9f8"
          }
        },
        {
          "scope": "keyword, constant.language",
          "settings": {
            "foreground": "#9872a2ff"
          }
        },
        {
          "scope": "variable.other.property",
          "settings": {
            "foreground": "#6089B4"
          }
        },
        {
          "scope": "entity.name.tag",
          "settings": {
            "foreground": "#a0171e"
          }
        }
      ]
    }
  },
  "workbench.iconTheme": "material-icon-theme",
  "git.confirmSync": false,
  "security.workspace.trust.untrustedFiles": "open",
  "redhat.telemetry.enabled": true,
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "editor.suggestSelection": "first",
  "typescript.preferences.importModuleSpecifier": "relative",
  "cSpell.ignorePaths": ["./yarn.lock", "./package-lock.json"],
  "cSpell.userWords": ["browserslist", "Chabot", "Icaro", "Matheus"],
  "cSpell.ignoreWords": ["typedefs"],
  "typescript.updateImportsOnFileMove.enabled": "always",
  "git.suggestSmartCommit": false,
  "window.zoomLevel": -1
}
